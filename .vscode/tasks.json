{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile JavaFX",
      "type": "shell",
      "command": "javac",
      "args": [
        "--module-path",
        "/opt/javafx/lib",
        "--add-modules",
        "javafx.controls,javafx.graphics",
        "ShowcaseApp.java",
        "MainScene.java",
        "ShapeFactory.java",
        "ExplodeEffect.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}